<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette: a cold, near-black chrome so page pixels stay the brightest thing on screen. -->
    <Color x:Key="WindowColor">#0A0D12</Color>
    <Color x:Key="ChromeColor">#0E131A</Color>
    <Color x:Key="PanelColor">#111823</Color>
    <Color x:Key="RaisedColor">#161F2B</Color>
    <Color x:Key="LineColor">#1E2836</Color>
    <Color x:Key="LineSoftColor">#17202C</Color>
    <Color x:Key="InkColor">#E8EFF9</Color>
    <Color x:Key="InkDimColor">#98A6BA</Color>
    <Color x:Key="InkMutedColor">#647389</Color>
    <Color x:Key="AccentColor">#5EE7FF</Color>
    <Color x:Key="AccentDeepColor">#2AA9D9</Color>
    <Color x:Key="VioletColor">#8B7CFF</Color>
    <Color x:Key="MintColor">#59D6A2</Color>
    <Color x:Key="DangerColor">#FF6B6B</Color>
    <Color x:Key="WarnColor">#F5B860</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="LineSoftBrush" Color="{StaticResource LineSoftColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="InkDimBrush" Color="{StaticResource InkDimColor}" />
    <SolidColorBrush x:Key="InkMutedBrush" Color="{StaticResource InkMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}" />
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" />
    <SolidColorBrush x:Key="MintBrush" Color="{StaticResource MintColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="#1A2331" />
    <SolidColorBrush x:Key="PressedBrush" Color="#212D3E" />
    <SolidColorBrush x:Key="FieldBrush" Color="#0A1017" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource VioletColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HairlineGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#005EE7FF" Offset="0" />
        <GradientStop Color="#5E5EE7FF" Offset="0.5" />
        <GradientStop Color="#005EE7FF" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

</ResourceDictionary>
