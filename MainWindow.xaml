<Window x:Class="Kitesurf.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Kitesurf.Windows.Controls"
        Title="Kitesurf Browser"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1280" Height="860" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ProgressThin" TargetType="ProgressBar">
            <Setter Property="Height" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True" Background="Transparent">
                            <Rectangle x:Name="Bar" Width="220" HorizontalAlignment="Left" Fill="{StaticResource AccentGradient}">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="-240" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="Slide">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Bar"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="-240" To="1700" Duration="0:0:1.5" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Slide" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource WindowBrush}" BorderBrush="#1A2230" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- Title bar: mark, tab strip, window buttons. -->
            <Grid Grid.Row="0" Background="{StaticResource ChromeBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Source="pack://application:,,,/Assets/app.png" Width="19" Height="19" Margin="13,0,10,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                <ScrollViewer Grid.Column="1" x:Name="TabScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              PreviewMouseWheel="TabScroll_PreviewMouseWheel">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl x:Name="TabItems" ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="32" MinWidth="128" MaxWidth="238" Margin="0,0,4,0" CornerRadius="8"
                                            BorderThickness="1" Cursor="Hand" Background="Transparent" BorderBrush="Transparent"
                                            MouseLeftButtonDown="TabChip_MouseLeftButtonDown"
                                            MouseLeftButtonUp="TabChip_MouseLeftButtonUp"
                                            MouseDown="TabChip_MouseDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#141D29" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="#18222F" />
                                                        <Setter Property="BorderBrush" Value="#25303F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Margin="10,0,6,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#39465A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource VioletBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="8,0,6,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" FontSize="12"
                                                       Foreground="#A9B6C8">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#93A1B5" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button Grid.Column="2" Style="{StaticResource TabClose}"
                                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip="Close tab (Ctrl+W)" AutomationProperties.Name="Close tab">
                                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource NavButton}" Width="26" Height="26" Margin="2,0,0,0"
                                Command="{Binding NewTabCommand}" ToolTip="New tab (Ctrl+T)" AutomationProperties.Name="New tab">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" />
                    </Button>
                    <Button Style="{StaticResource CloseWindowButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close window">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Toolbar: navigation, address, view actions. -->
            <Grid Grid.Row="1" Background="{StaticResource ChromeBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Style="{StaticResource NavButton}" Command="{Binding BackCommand}" ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ForwardCommand}" ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward">
                        <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ReloadCommand}" ToolTip="Reload (Ctrl+R)" AutomationProperties.Name="Reload">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding HomeCommand}" ToolTip="Home" AutomationProperties.Name="Home">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                </StackPanel>

                <Border Grid.Column="1" Height="36" Margin="8,0,12,0" VerticalAlignment="Center" CornerRadius="9"
                        Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="7" Height="7" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#3C4A5E" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDemo}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource VioletBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedTab.IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource MintBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <TextBox x:Name="AddressBox" Grid.Column="1" Style="{StaticResource OmniBox}" Margin="9,0,8,0"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditAddress}"
                                 KeyDown="AddressBox_KeyDown"
                                 GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                                 LostKeyboardFocus="AddressBox_LostKeyboardFocus"
                                 PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown" />

                        <TextBlock Grid.Column="1" Text="Enter an address, or search the web" Margin="11,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12.5"
                                   Foreground="#4E5B6E">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=AddressBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Border CornerRadius="5" Background="#262238" Padding="6,1" Margin="0,0,6,0"
                                    Visibility="{Binding IsAccessProtected, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Authenticated with a Cloudflare Access service token">
                                <TextBlock Text="ACCESS" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource VioletBrush}" />
                            </Border>
                            <Border CornerRadius="5" Background="#1B2634" Padding="6,1"
                                    Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="DEMO" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource InkDimBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Style="{StaticResource NavButton}" Command="{Binding ToggleConsoleCommand}" ToolTip="Console (Ctrl+`)" AutomationProperties.Name="Console">
                        <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Screenshot_Click" ToolTip="Save a screenshot of this page" AutomationProperties.Name="Save screenshot">
                        <TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding CopyFrameCommand}"
                            ToolTip="Copy the frame to the clipboard (Ctrl+Shift+S)" AutomationProperties.Name="Copy frame">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Height="30" Padding="12,0" Margin="4,0,0,0"
                            Click="DevTools_Click" FontSize="11.5" ToolTip="Open Chrome DevTools for this engine">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE943;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="DevTools" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ProgressBar Grid.ColumnSpan="3" Style="{StaticResource ProgressThin}" VerticalAlignment="Bottom"
                             IsIndeterminate="True" IsHitTestVisible="False"
                             Visibility="{Binding SelectedTab.IsLoading, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed, TargetNullValue=Collapsed}" />
            </Grid>

            <!-- Content: page surface plus the console drawer. -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding ConsoleGridWidth}" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" ClipToBounds="True">
                    <controls:PageSurface x:Name="Surface" Visibility="{Binding HasTabs, Converter={StaticResource BoolToVisibility}}" />
                    <controls:WelcomeView x:Name="Welcome" Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Thumb Grid.Column="1" Width="6" Cursor="SizeWE" Background="Transparent"
                       Visibility="{Binding ConsoleOpen, Converter={StaticResource BoolToVisibility}}"
                       DragDelta="ConsoleSplitter_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Border Width="1" Background="{StaticResource LineSoftBrush}" HorizontalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>

                <Border Grid.Column="2" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1,0,0,0"
                        Visibility="{Binding ConsoleOpen, Converter={StaticResource BoolToVisibility}}">
                    <controls:ConsolePane x:Name="ConsolePanel" />
                </Border>
            </Grid>

            <!-- Status bar: engine truth, viewport truth, connection truth. -->
            <Grid Grid.Row="3" Background="{StaticResource ChromeBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,0,0">
                    <TextBlock Text="{Binding EngineName}" FontSize="11" Foreground="{StaticResource InkDimBrush}" />
                    <TextBlock Text="{Binding EngineDetail}" FontSize="11" Margin="8,0,0,0" Foreground="#4E5B6E" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusHint}" FontSize="11" Margin="16,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#5C6A7E" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,13,0">
                    <TextBlock Text="{Binding ViewportText}" FontSize="11" FontFamily="{StaticResource MonoFont}"
                               Foreground="#5C6A7E" />
                    <Border Width="1" Height="11" Background="{StaticResource LineBrush}" Margin="10,0" />
                    <TextBlock Text="{Binding TelemetryText}" FontSize="11" FontFamily="{StaticResource MonoFont}"
                               Foreground="#5C6A7E" />
                    <Border Width="1" Height="11" Background="{StaticResource LineBrush}" Margin="10,0" />
                    <TextBlock Text="{Binding LatencyText}" FontSize="11" FontFamily="{StaticResource MonoFont}"
                               Foreground="#5C6A7E" />
                    <Border Width="1" Height="11" Background="{StaticResource LineBrush}" Margin="10,0" />
                    <TextBlock Text="{Binding SocketText}" FontSize="11" FontFamily="{StaticResource MonoFont}"
                               Foreground="#3E4B5C" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                </StackPanel>
            </Grid>

            <!-- Toast: transient, never blocks input. -->
            <Border x:Name="Toast" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,28" CornerRadius="8" Background="#E6111822" BorderBrush="#2A3646" BorderThickness="1"
                    Padding="16,9" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="ToastText" FontSize="12" Foreground="{StaticResource InkBrush}" />
            </Border>
        </Grid>
    </Border>
</Window>
