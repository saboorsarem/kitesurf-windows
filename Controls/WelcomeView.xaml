<UserControl x:Class="Kitesurf.Windows.Controls.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBrush}">

    <Grid>
        <!-- Ambient wash: sits behind the connect card and keeps the empty state from feeling flat. -->
        <Ellipse Width="1080" Height="760" HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="0,-320,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2A2AA9D9" Offset="0" />
                    <GradientStop Color="#0F8B7CFF" Offset="0.55" />
                    <GradientStop Color="#000A0D12" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
            </ScrollViewer.Resources>
            <StackPanel MaxWidth="780" HorizontalAlignment="Center" Margin="40,54,40,44">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Kitesurf" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <Border CornerRadius="5" Background="#1A2432" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WINDOWS" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource InkDimBrush}"
                                   FontFamily="{StaticResource UiFont}" />
                    </Border>
                </StackPanel>

                <TextBlock Text="The engine that renders in the cloud,&#x0a;driven from a native window."
                           TextAlignment="Center" Margin="0,26,0,0" LineHeight="38"
                           FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" />

                <TextBlock Margin="0,14,0,0" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22"
                           FontFamily="{StaticResource UiFont}" FontSize="13.5" Foreground="{StaticResource InkDimBrush}"
                           Text="Kitesurf parses HTML, applies CSS, runs page JavaScript and paints frames on Cloudflare Workers. This app is the missing Windows client: it speaks the engine's DevTools protocol and turns frames into a real browser window." />

                <Border CornerRadius="14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Margin="0,30,0,0" Padding="22">
                    <StackPanel>
                        <TextBlock Text="CONNECT TO AN ENGINE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkMutedBrush}" FontFamily="{StaticResource UiFont}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EngineAddressBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Engine address"
                                     Text="{Binding EngineAddress, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="EngineAddressBox_KeyDown" />
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Connect"
                                    Margin="10,0,0,0" Command="{Binding ConnectCommand}" AutomationProperties.Name="Connect to engine" />
                        </Grid>

                        <TextBlock Text="{Binding StatusHint}" Margin="2,10,0,0" TextWrapping="Wrap"
                                   FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{StaticResource InkMutedBrush}" />

                        <Expander Style="{StaticResource DarkExpander}" IsExpanded="{Binding AccessExpanded, Mode=TwoWay}"
                                  Header="Cloudflare Access service token (optional, for deployed Workers)">
                            <StackPanel>
                                <TextBlock Text="CF-Access-Client-Id" FontSize="11.5" Foreground="{StaticResource InkDimBrush}"
                                           FontFamily="{StaticResource UiFont}" />
                                <TextBox Style="{StaticResource FieldBox}" Height="34" Margin="0,5,0,0"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                         AutomationProperties.Name="CF Access client id"
                                         Text="{Binding AccessClientId, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="CF-Access-Client-Secret" FontSize="11.5" Margin="0,12,0,0"
                                           Foreground="{StaticResource InkDimBrush}" FontFamily="{StaticResource UiFont}" />
                                <PasswordBox x:Name="AccessSecretBox" Style="{StaticResource PasswordField}" Margin="0,5,0,0"
                                             AutomationProperties.Name="CF Access client secret"
                                             PasswordChanged="AccessSecretBox_PasswordChanged" />

                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11" LineHeight="16"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           Text="Required when the Worker is behind Cloudflare Zero Trust. The secret is encrypted with Windows DPAPI before it is written to settings.json, and is never logged." />
                            </StackPanel>
                        </Expander>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Height="1" Background="{StaticResource LineSoftBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="or" Margin="12,0" FontSize="11"
                                       FontFamily="{StaticResource UiFont}" Foreground="{StaticResource InkMutedBrush}" />
                            <Border Grid.Column="2" Height="1" Background="{StaticResource LineSoftBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <Button Style="{StaticResource GhostButton}" Margin="0,16,0,0" HorizontalAlignment="Stretch"
                                Command="{Binding StartDemoCommand}" AutomationProperties.Name="Start demo engine">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Start the built-in demo engine" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Border CornerRadius="4" Background="#1B2634" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="LOCAL" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource InkDimBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <TextBlock Margin="2,10,0,0" TextWrapping="Wrap" FontFamily="{StaticResource UiFont}" FontSize="11.5"
                                   Foreground="{StaticResource InkMutedBrush}"
                                   Text="The demo engine is a synthetic page painted on this machine. It exercises the same socket, frame and input paths a Cloudflare-hosted engine uses — it is not a browser." />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="RecentPanel" Margin="0,24,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SavedEngines.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="RECENT ENGINES" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource InkMutedBrush}" FontFamily="{StaticResource UiFont}" Margin="2,0,0,10" />
                    <ItemsControl ItemsSource="{Binding SavedEngines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" Height="32" Padding="14,0" Margin="0,0,8,8"
                                        Command="{Binding DataContext.ConnectSavedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                        <TextBlock Text="{Binding Address}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{StaticResource InkMutedBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Grid Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Frames, not iframes" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="Each tab streams JPEG frames from its own engine session and acks them one by one."
                                   TextWrapping="Wrap" Margin="0,4,0,0" FontFamily="{StaticResource UiFont}" FontSize="11.5"
                                   LineHeight="17" Foreground="{StaticResource InkMutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Real input" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="Clicks, wheel and keystrokes are mapped back to engine coordinates, not simulated locally."
                                   TextWrapping="Wrap" Margin="0,4,0,0" FontFamily="{StaticResource UiFont}" FontSize="11.5"
                                   LineHeight="17" Foreground="{StaticResource InkMutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="No browser install" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="There is no Chromium under this window. The engine does the parsing, layout and paint."
                                   TextWrapping="Wrap" Margin="0,4,0,0" FontFamily="{StaticResource UiFont}" FontSize="11.5"
                                   LineHeight="17" Foreground="{StaticResource InkMutedBrush}" />
                    </StackPanel>
                </Grid>

                <TextBlock Margin="0,26,0,0" TextWrapping="Wrap" FontFamily="{StaticResource UiFont}" FontSize="11"
                           Foreground="#4E5B6E"
                           Text="A Cloudflare-hosted engine needs a Workers Paid plan, because every page runs in its own Dynamic Worker. For local development run pnpm run dev in the kitesurf repository and connect to 127.0.0.1:8787." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
